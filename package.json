{
  "name": "filefinder-ai",
  "private": true,
  "version": "0.1.0",
  "description": "Find, understand, and organize files on your computer using natural language.",
  "author": "FileFinder AI",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "electron": "electron .",
    "electron:wait": "wait-on http://127.0.0.1:5173 && electron .",
    "electron:dev": "concurrently -k \"cross-env BROWSER=none vite\" \"npm run electron:wait\"",
    "test:index": "electron electron/scripts/test-index.js",
    "test:search": "electron electron/scripts/test-search.js",
    "test:ai": "electron electron/scripts/test-ai.js",
    "test:natural-search": "electron electron/scripts/test-natural-search.js",
    "test:preview": "electron electron/scripts/test-preview.js",
    "test:organization": "electron electron/scripts/test-organization.js",
    "test:assistant": "electron electron/scripts/test-assistant.js"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sql.js": "^1.14.2"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^38.2.1",
    "oxlint": "^1.81.0",
    "vite": "^8.3.0",
    "wait-on": "^9.0.1"
  }
}
